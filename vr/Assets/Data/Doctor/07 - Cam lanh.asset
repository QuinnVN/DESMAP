--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0e9fcfdc0faab7e499d085f5d5ebf657, type: 3}
  m_Name: 07 - Cam lanh
  m_EditorClassIdentifier: NCKH.Doctor::NCKH.VR.Doctor.DoctorCaseDefinition
  patientName: "B\xF9i Kh\xE1nh Linh"
  selectionWeight: 1
  initialDialogue:
    transcript: "Ba ng\xE0y nay t\xF4i s\u1ED5 m\u0169i, ngh\u1EB9t m\u0169i, h\u1EAFt
      h\u01A1i v\xE0 h\u01A1i \u0111au h\u1ECDng; t\xF4i ch\u1EC9 s\u1ED1t nh\u1EB9
      m\u1ED9t l\u1EA7n."
    audioClip: {fileID: 0}
    selectableCards:
    - id: cold-time
      text: "Tri\u1EC7u ch\u1EE9ng k\xE9o d\xE0i ba ng\xE0y"
      correctCategory: 0
      essential: 1
    - id: cold-nose
      text: "S\u1ED5 m\u0169i, ngh\u1EB9t m\u0169i v\xE0 h\u1EAFt h\u01A1i"
      correctCategory: 2
      essential: 1
    - id: cold-throat
      text: "\u0110au h\u1ECDng nh\u1EB9"
      correctCategory: 2
      essential: 1
    - id: cold-fever
      text: "Ch\u1EC9 s\u1ED1t nh\u1EB9 m\u1ED9t l\u1EA7n"
      correctCategory: 2
      essential: 1
  phases:
  - id: cold-q1
    question: "C\xE1c tri\u1EC7u ch\u1EE9ng xu\u1EA5t hi\u1EC7n nh\u01B0 th\u1EBF
      n\xE0o?"
    response:
      transcript: "Ban \u0111\u1EA7u t\xF4i r\xE1t h\u1ECDng, h\xF4m sau m\u1EDBi
        ngh\u1EB9t m\u0169i v\xE0 ho nh\u1EB9."
      audioClip: {fileID: 0}
      selectableCards:
      - id: cold-course
        text: "R\xE1t h\u1ECDng tr\u01B0\u1EDBc, sau \u0111\xF3 ngh\u1EB9t m\u0169i
          v\xE0 ho nh\u1EB9"
        correctCategory: 0
        essential: 1
  - id: cold-q2
    question: "G\u1EA7n \u0111\xE2y ch\u1ECB c\xF3 ti\u1EBFp x\xFAc v\u1EDBi ng\u01B0\u1EDDi
      c\xF3 tri\u1EC7u ch\u1EE9ng t\u01B0\u01A1ng t\u1EF1 kh\xF4ng?"
    response:
      transcript: "Con t\xF4i b\u1ECB s\u1ED5 m\u0169i v\xE0i ng\xE0y tr\u01B0\u1EDBc,
        ngo\xE0i ra t\xF4i kh\xF4ng \u0111i xa."
      audioClip: {fileID: 0}
      selectableCards:
      - id: cold-contact
        text: "Ti\u1EBFp x\xFAc con b\u1ECB s\u1ED5 m\u0169i"
        correctCategory: 1
        essential: 1
  - id: cold-q3
    question: "Ch\u1ECB c\xF3 b\u1EC7nh n\u1EC1n \u0111\xE1ng ch\xFA \xFD kh\xF4ng?"
    response:
      transcript: "T\xF4i kh\u1ECFe m\u1EA1nh, kh\xF4ng hen v\xE0 kh\xF4ng c\xF3
        b\u1EC7nh ph\u1ED5i m\u1EA1n t\xEDnh."
      audioClip: {fileID: 0}
      selectableCards:
      - id: cold-history
        text: "Kh\xF4ng c\xF3 b\u1EC7nh n\u1EC1n h\xF4 h\u1EA5p"
        correctCategory: 3
        essential: 1
