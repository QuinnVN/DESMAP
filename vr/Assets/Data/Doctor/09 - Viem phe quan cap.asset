  m_Script: {fileID: 11500000, guid: 0e9fcfdc0faab7e499d085f5d5ebf657, type: 3}
  m_Name: 09 - Viem phe quan cap
  m_EditorClassIdentifier: NCKH.Doctor::NCKH.VR.Doctor.DoctorCaseDefinition
  patientName: "Ho\xE0ng Tu\u1EA5n Ki\u1EC7t"
  selectionWeight: 1
  initialDialogue:
    transcript: "Sau m\u1ED9t \u0111\u1EE3t c\u1EA3m, t\xF4i ho nhi\u1EC1u \u0111\xE3
      s\xE1u ng\xE0y, l\xFAc \u0111\u1EA7u ho khan r\u1ED3i chuy\u1EC3n sang c\xF3
      \xEDt \u0111\u1EDDm."
    audioClip: {fileID: 0}
    selectableCards:
    - id: bron-time
      text: "Ho k\xE9o d\xE0i s\xE1u ng\xE0y sau c\u1EA3m"
      correctCategory: 0
      essential: 1
    - id: bron-cough
      text: "Ho t\u1EEB khan chuy\u1EC3n sang c\xF3 \u0111\u1EDDm"
      correctCategory: 2
      essential: 1
  phases:
  - id: bron-q1
    question: "Anh c\xF3 s\u1ED1t cao, kh\xF3 th\u1EDF hay \u0111au ng\u1EF1c kh\xF4ng?"
    response:
      transcript: "T\xF4i ch\u1EC9 s\u1ED1t nh\u1EB9, h\u01A1i r\xE1t sau x\u01B0\u01A1ng
        \u1EE9c khi ho, kh\xF4ng kh\xF3 th\u1EDF l\xFAc ngh\u1EC9."
      audioClip: {fileID: 0}
      selectableCards:
      - id: bron-detail
        text: "S\u1ED1t nh\u1EB9 v\xE0 r\xE1t ng\u1EF1c khi ho"
        correctCategory: 2
        essential: 1
      - id: bron-no-dyspnea
        text: "Kh\xF4ng kh\xF3 th\u1EDF l\xFAc ngh\u1EC9"
        correctCategory: 2
        essential: 1
  - id: bron-q2
    question: "Anh c\xF3 ti\u1EBFp x\xFAc kh\xF3i b\u1EE5i ho\u1EB7c ng\u01B0\u1EDDi
      \u0111ang b\u1EC7nh kh\xF4ng?"
    response:
      transcript: "T\xF4i l\xE0m \u1EDF n\u01A1i c\xF3 nhi\u1EC1u kh\xF3i v\xE0 v\xE0i
        \u0111\u1ED3ng nghi\u1EC7p c\u0169ng \u0111ang ho."
      audioClip: {fileID: 0}
      selectableCards:
      - id: bron-exposure
        text: "Ti\u1EBFp x\xFAc kh\xF3i v\xE0 \u0111\u1ED3ng nghi\u1EC7p \u0111ang
          ho"
        correctCategory: 1
        essential: 1
  - id: bron-q3
    question: "Anh c\xF3 hen, b\u1EC7nh ph\u1ED5i ho\u1EB7c h\xFAt thu\u1ED1c kh\xF4ng?"
    response:
      transcript: "T\xF4i kh\xF4ng c\xF3 b\u1EC7nh ph\u1ED5i nh\u01B0ng h\xFAt kho\u1EA3ng
        n\u0103m \u0111i\u1EBFu thu\u1ED1c m\u1ED7i ng\xE0y."
      audioClip: {fileID: 0}
      selectableCards:
      - id: bron-history
        text: "H\xFAt kho\u1EA3ng n\u0103m \u0111i\u1EBFu thu\u1ED1c m\u1ED7i ng\xE0y"
        correctCategory: 3
        essential: 1
