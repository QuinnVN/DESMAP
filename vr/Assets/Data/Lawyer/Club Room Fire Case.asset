  m_Script: {fileID: 11500000, guid: a46e564cb23a3d74d909e3b4b7a7ff24, type: 3}
  m_Name: Club Room Fire Case
  m_EditorClassIdentifier: NCKH.Lawyer::NCKH.VR.Lawyer.LawyerCaseDefinition
  caseId: club-room-fire
  caseTitle: "V\u1EE4 CH\xC1Y PH\xD2NG CLB"
  caseSummary: "Kho\u1EA3ng 16:20, m\u1ED9t v\u1EE5 ch\xE1y x\u1EA3y ra t\u1EA1i
    ph\xF2ng CLB c\u1EE7a tr\u01B0\u1EDDng. \u0110\xE1m ch\xE1y b\u1EAFt \u0111\u1EA7u
    g\u1EA7n \u1ED5 c\u1EAFm \u0111i\u1EC7n b\xEAn b\xE0n l\xE0m vi\u1EC7c. Lan n\xF3i
    \u0111\xE3 th\u1EA5y Minh r\u1EDDi \u0111i khi m\u1ED9t thi\u1EBFt b\u1ECB v\u1EABn
    c\xF2n c\u1EAFm \u0111i\u1EC7n; Minh kh\u1EB3ng \u0111\u1ECBnh m\xECnh \u0111\xE3
    r\xFAt b\u1ED9 s\u1EA1c."
  investigationObjective: "Thu th\u1EADp th\xF4ng tin, ki\u1EC3m tra l\u1EDDi khai
    v\xE0 m\xE2u thu\u1EABn, ch\u1ECDn ch\u1EE9ng c\u1EE9 c\xF3 gi\xE1 tr\u1ECB,
    r\u1ED3i x\xE2y d\u1EF1ng l\u1EADp lu\u1EADn b\u1EA3o v\u1EC7 Minh."
  timeline:
  - "16:00 \u2014 Minh v\xE0o ph\xF2ng CLB."
  - "16:03 \u2014 Minh s\u1EED d\u1EE5ng \u1ED5 \u0111i\u1EC7n g\u1EA7n b\xE0n l\xE0m
    vi\u1EC7c."
  - "16:05 \u2014 Minh r\u1EDDi ph\xF2ng."
  - "16:12 \u2014 Minh quay l\u1EA1i h\xE0nh lang."
  - "16:20 \u2014 H\u1EC7 th\u1ED1ng b\xE1o ch\xE1y k\xEDch ho\u1EA1t."
  witnesses:
  - "Lan \u2014 khai th\u1EA5y thi\u1EBFt b\u1ECB v\u1EABn c\xF2n c\u1EAFm \u0111i\u1EC7n."
  - "Minh \u2014 kh\u1EB3ng \u0111\u1ECBnh \u0111\xE3 r\xFAt b\u1ED9 s\u1EA1c tr\u01B0\u1EDBc
    khi r\u1EDDi \u0111i."
  caseDetails:
  - "B\xE1o c\xE1o ban \u0111\u1EA7u ch\u1EC9 khoanh v\xF9ng khu v\u1EF1c \u1ED5
    c\u1EAFm; k\u1EBFt lu\u1EADn gi\xE1m \u0111\u1ECBnh cu\u1ED1i c\xF9ng c\xF3 th\u1EC3
    thay th\u1EBF nh\u1EADn \u0111\u1ECBnh s\u01A1 b\u1ED9 n\xE0y."
  clues:
  - id: clue-01
    title: "Camera h\xE0nh lang"
    description: "16:00: Minh v\xE0o ph\xF2ng CLB. 16:05: Minh r\u1EDDi kh\u1ECFi
      ph\xF2ng. Camera kh\xF4ng ghi l\u1EA1i \u0111\u01B0\u1EE3c b\xEAn trong ph\xF2ng."
    category: 0
  - id: clue-02
    title: "Camera trong ph\xF2ng"
    description: "16:03: Minh \u0111\u01B0\u1EE3c ghi nh\u1EADn \u0111ang s\u1EED
      d\u1EE5ng \u1ED5 \u0111i\u1EC7n g\u1EA7n b\xE0n l\xE0m vi\u1EC7c, c\u0169ng
      l\xE0 khu v\u1EF1c sau \u0111\xF3 \u0111\u01B0\u1EE3c x\xE1c \u0111\u1ECBnh
      l\xE0 n\u01A1i \u0111\xE1m ch\xE1y b\u1EAFt \u0111\u1EA7u."
    category: 0
  - id: clue-03
    title: "L\u1EDDi khai c\u1EE7a Lan"
    description: "Tr\u01B0\u1EDBc khi Minh r\u1EDDi \u0111i, t\xF4i th\u1EA5y m\u1ED9t
      thi\u1EBFt b\u1ECB v\u1EABn c\xF2n \u0111\u01B0\u1EE3c c\u1EAFm \u1EDF \u1ED5
      \u0111i\u1EC7n."
    category: 1
  - id: clue-04
    title: "B\xE1o c\xE1o hi\u1EC7n tr\u01B0\u1EDDng ban \u0111\u1EA7u"
    description: "\u0110\xE1m ch\xE1y c\xF3 kh\u1EA3 n\u0103ng b\u1EAFt \u0111\u1EA7u
      t\u1EEB khu v\u1EF1c \u1ED5 c\u1EAFm \u0111i\u1EC7n g\u1EA7n b\xE0n l\xE0m
      vi\u1EC7c, nh\u01B0ng ch\u01B0a x\xE1c \u0111\u1ECBnh ch\xEDnh x\xE1c thi\u1EBFt
      b\u1ECB n\xE0o g\xE2y ra s\u1EF1 c\u1ED1."
    category: 2
  - id: clue-05
    title: "L\u1EDDi khai c\u1EE7a Minh"
    description: "Em c\xF3 s\u1EA1c laptop \u1EDF \u0111\xF3, nh\u01B0ng em \u0111\xE3
      r\xFAt s\u1EA1c tr\u01B0\u1EDBc khi r\u1EDDi \u0111i."
    category: 4
  - id: clue-06
    title: "Th\u1EDDi \u0111i\u1EC3m b\xE1o ch\xE1y"
    description: "16:20: H\u1EC7 th\u1ED1ng b\xE1o ch\xE1y c\u1EE7a tr\u01B0\u1EDDng
      \u0111\u01B0\u1EE3c k\xEDch ho\u1EA1t. Minh \u0111\xE3 r\u1EDDi ph\xF2ng 15
      ph\xFAt tr\u01B0\u1EDBc \u0111\xF3."
    category: 0
  - id: clue-07
    title: "Camera h\xE0nh lang 16:05"
    description: "Camera cho th\u1EA5y Minh r\u1EDDi ph\xF2ng v\u1EDBi laptop tr\xEAn
      tay."
    category: 0
  - id: clue-08
    title: "Ki\u1EC3m tra c\u1EEDa ph\xF2ng"
    description: "Kh\xF4ng c\xF3 d\u1EA5u hi\u1EC7u c\u1EEDa t\u1EEBng b\u1ECB kh\xF3a
      trong kho\u1EA3ng th\u1EDDi gian x\u1EA3y ra v\u1EE5 vi\u1EC7c."
    category: 2
  - id: clue-09
    title: "Camera c\u1EA7u thang 16:07"
    description: "Khi Minh m\u1EDF balo, m\u1ED9t d\xE2y s\u1EA1c m\xE0u tr\u1EAFng
      \u0111\u01B0\u1EE3c nh\xECn th\u1EA5y b\xEAn trong."
    category: 0
  - id: clue-10
    title: "Tin nh\u1EAFn 16:04"
    description: "Minh nh\u1EAFn cho b\u1EA1n: \u201CT xu\u1ED1ng li\u1EC1n \u0111\xE2y.\u201D"
    category: 6
  - id: clue-11
    title: "Camera h\xE0nh lang"
    description: "Minh r\u1EDDi ph\xF2ng l\xFAc 16:05:18."
    category: 0
  - id: clue-12
    title: "Camera h\xE0nh lang 16:08"
    description: "M\u1ED9t h\u1ECDc sinh kh\xE1c \u0111i v\xE0o khu v\u1EF1c ph\xF2ng
      CLB l\xFAc 16:08."
    category: 0
  - id: clue-13
    title: "Camera h\xE0nh lang 16:12"
    description: "Minh \u0111\u1EE9ng tr\u01B0\u1EDBc c\u1EEDa kho\u1EA3ng 20 gi\xE2y
      r\u1ED3i r\u1EDDi \u0111i, kh\xF4ng b\u01B0\u1EDBc v\xE0o ph\xF2ng."
    category: 0
  - id: clue-14
    title: "D\u1EEF li\u1EC7u c\u1EA3m bi\u1EBFn kh\xF3i"
    description: "N\u1ED3ng \u0111\u1ED9 kh\xF3i b\u1EAFt \u0111\u1EA7u t\u0103ng
      r\xF5 t\u1EEB kho\u1EA3ng 16:13."
    category: 2
  - id: clue-15
    title: "Camera h\xE0nh lang"
    description: "Camera x\xE1c nh\u1EADn Minh v\u1EABn mang balo l\xFAc quay l\u1EA1i."
    category: 6
  - id: clue-16
