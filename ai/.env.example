# Copy this file to .env in ai/. Restart the backend after edits.
# Process environment variables override .env. Never commit credentials.

# 1. Backend connection and private storage
# Use 0.0.0.0 for headset access; enter the computer's LAN IP on the headset.
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
# Relative paths resolve from ai/. Use an external path for private storage.
RECORDINGS_DIR=recordings

# 2. LLM provider
# openrouter = cloud models; legacy/shadow = local LLM.
PIPELINE_MODE=legacy
OPENROUTER_API_KEY=

# 3. Sales Part 2 feature switches
# Dialogue and rubric settings are frozen when a new session starts.
# Adaptive v2 requires BOTH PIPELINE_MODE=openrouter and ENABLED=true.
# VERSION=v2 alone does not enable it. The rubric is versioned by code.
SALES_ADAPTIVE_DIALOGUE_ENABLED=false
SALES_ADAPTIVE_VERSION=v2
SALES_ADAPTIVE_REASONING=off
SALES_LUNA_ARBITRATION_ENABLED=true
SALES_MAX_TURNS=8
# Emergency bypass of AI Part 2; keep false for the dialogue flow.
DISABLE_AI_SALE_PT2=false

# 4. Speech recognition (STT, local, independent of the LLM provider)
# Install once with `ai setup stt` in the backend console.
# The backend loads the installed model on every startup.
SHERPA_MODEL_DIR=models/sherpa-onnx-zipformer-vi-30M-int8-2026-02-09
SHERPA_NUM_THREADS=1
SHERPA_TIMEOUT_SECONDS=20

# 5. Customer speech (TTS, local Supertonic, also used with OpenRouter)
# Start the service with `ai start supertonic` in the backend console.
SUPERTONIC_BASE_URL=http://127.0.0.1:7788
TTS_QUALITY=5
TTS_TIMEOUT_SECONDS=8
# Optional executable override; otherwise ai/.venv/Scripts/supertonic.exe.
# SUPERTONIC_SERVER_BIN=

# 6. Local LLM (used only by legacy/shadow mode)
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=qwen3-4b
LLM_USE_AMD_HYBRID=false
# Optional executable override for the managed llama.cpp server.
# LLAMA_SERVER_BIN=

# 7. Advanced Sales tuning
# Provider policy applies to Sales Decisions and chat requests.
SALES_OPENROUTER_DATA_COLLECTION=deny
SALES_OPENROUTER_ZDR=false
# Classifier, non-adaptive writer, arbitration, and Part 1 deadlines.
SALES_JEV_TIMEOUT_SECONDS=3
SALES_WRITER_TIMEOUT_SECONDS=4
SALES_LUNA_TIMEOUT_SECONDS=6
SALES_PART1_TIMEOUT_SECONDS=30
# Adaptive turn deadline (includes guard); generation completion cap.
SALES_ADAPTIVE_TIMEOUT_SECONDS=45
SALES_ADAPTIVE_MAX_TOKENS=4096
# Used only when SALES_ADAPTIVE_REASONING=on.
SALES_ADAPTIVE_REASONING_MAX_TOKENS=1024

# 8. Final evaluation writer
# Uses the provider selected above and the same private OpenRouter key.
FINAL_EVALUATION_REQUEST_TIMEOUT_SECONDS=180
FINAL_EVALUATION_MAX_PROMPT_CHARS=60000
FINAL_EVALUATION_MAX_TOKENS=12000

# 9. Optional database and diagnostic access
# Leave unset to keep results local and diagnostic endpoints protected.
# MONGODB_URI=
# MONGODB_DATABASE=desmap
# MONGODB_RESULTS_COLLECTION=game_results
# BACKEND_API_TOKEN=
# SALES_DIAGNOSTIC_TOKEN=
# LAWYER_DIAGNOSTIC_TOKEN=
# Further optional limits are documented in readme.md, Configuration.
