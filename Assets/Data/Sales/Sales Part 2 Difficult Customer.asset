  customerProfile:
    name: Lan
    age: 22
    role: "Sinh vi\xEAn \u0111\u1EA1i h\u1ECDc"
    playerAddress: em
    customerAddress: "ch\u1ECB"
  openingComplaint: "Em \u01A1i, ch\u1ECB mu\u1ED1n \u0111\u1ED5i \u0111\xF4i gi\xE0y
    n\xE0y. Ch\u1ECB m\u1EDBi mua \u1EDF \u0111\xE2y ba ng\xE0y tr\u01B0\u1EDBc,
    nh\u01B0ng mang v\xE0o th\xEC b\u1ECB \u0111au ch\xE2n. L\u1EA7n tr\u01B0\u1EDBc
    em t\u01B0 v\u1EA5n \u0111\xF4i n\xE0y ph\xF9 h\u1EE3p v\u1EDBi ch\u1ECB n\xEAn
    ch\u1ECB kh\xE1 th\u1EA5t v\u1ECDng."
  storePolicy:
    title: "CH\xCDNH S\xC1CH \u0110\u1ED4I H\xC0NG"
    eligibility: "Trong 7 ng\xE0y \u2022 Gi\xE0y c\xF2n nguy\xEAn v\u1EB9n"
    exclusions: "Kh\xF4ng ho\xE0n ti\u1EC1n ho\u1EB7c gi\u1EA3m gi\xE1"
    escalation: "T\u1EF1 x\u1EED l\xFD, kh\xF4ng chuy\u1EC3n qu\u1EA3n l\xFD"
  mandatoryTrustChallenge: "Nh\u01B0ng l\u1EA7n tr\u01B0\u1EDBc em c\u0169ng t\u01B0
    v\u1EA5n \u0111\xF4i n\xE0y ph\xF9 h\u1EE3p v\u1EDBi ch\u1ECB. L\xE0m sao ch\u1ECB
    bi\u1EBFt l\u1EA7n n\xE0y s\u1EBD kh\xF4ng g\u1EB7p v\u1EA5n \u0111\u1EC1 t\u01B0\u01A1ng
    t\u1EF1?"
  objectives:
  - objective: 1
    displayText: "L\u1EAENG NGHE V\xC0 L\xC0M R\xD5 PH\xC0N N\xC0N"
  - objective: 2
    displayText: "T\xCCM NGUY\xCAN NH\xC2N TH\u1EF0C S\u1EF0"
  - objective: 3
    displayText: "\u0110\u1EC0 XU\u1EA4T GI\u1EA2I PH\xC1P PH\xD9 H\u1EE2P"
  - objective: 4
    displayText: "KH\xD4I PH\u1EE4C NI\u1EC0M TIN"
  authoredEndings:
    restored: "\u1EEA, v\u1EADy ch\u1ECB s\u1EBD th\u1EED \u0111\xF4i nh\u1EB9 h\u01A1n.
      L\u1EA7n sau ch\u1ECB v\u1EABn s\u1EBD quay l\u1EA1i nh\u1EDD em t\u01B0 v\u1EA5n."
    partiallyRestored: "\u0110\u01B0\u1EE3c r\u1ED3i, ch\u1ECB s\u1EBD th\u1EED \u0111\u1ED5i
      sang \u0111\xF4i n\xE0y tr\u01B0\u1EDBc."
    lost: "Th\xF4i, ch\u1ECB kh\xF4ng mu\u1ED1n ti\u1EBFp t\u1EE5c n\u1EEFa. L\u1EA7n
      sau ch\u1ECB s\u1EBD mua \u1EDF ch\u1ED7 kh\xE1c."
