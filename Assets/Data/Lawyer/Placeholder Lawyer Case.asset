  m_Name: Placeholder Lawyer Case
  m_EditorClassIdentifier: NCKH.Lawyer::NCKH.VR.Lawyer.LawyerCaseDefinition
  caseId: lawyer-placeholder
  caseTitle: "[N\u1ED8I DUNG M\u1EAAU] H\u1ED2 S\u01A0 V\u1EE4 \xC1N"
  caseSummary: "[N\u1ED8I DUNG M\u1EAAU] M\u1ED9t s\u1EF1 vi\u1EC7c gi\u1EA3 \u0111\u1ECBnh
    \u0111ang \u0111\u01B0\u1EE3c \u0111i\u1EC1u tra. To\xE0n b\u1ED9 t\xEAn, \u0111\u1ECBa
    \u0111i\u1EC3m v\xE0 t\xECnh ti\u1EBFt s\u1EBD \u0111\u01B0\u1EE3c thay th\u1EBF
    b\u1EB1ng n\u1ED9i dung ch\xEDnh th\u1EE9c."
  investigationObjective: "X\xE1c minh hai m\xE2u thu\u1EABn quan tr\u1ECDng trong
    l\u1EDDi khai c\u1EE7a b\u1ECB c\xE1o v\xE0 thu th\u1EADp manh m\u1ED1i cho b\u1EA3ng
    ch\u1EE9ng c\u1EE9."
  timeline:
  - "20:00 \u2014 B\u1ECB c\xE1o khai \u0111\xE3 r\u1EDDi khu v\u1EF1c."
  - "20:10 \u2014 Camera m\u1EABu ghi nh\u1EADn chuy\u1EC3n \u0111\u1ED9ng."
  - "20:15 \u2014 Nh\xE2n ch\u1EE9ng A b\xE1o c\xE1o s\u1EF1 vi\u1EC7c."
  witnesses:
  - "Nh\xE2n ch\u1EE9ng A \u2014 c\xF3 m\u1EB7t g\u1EA7n hi\u1EC7n tr\u01B0\u1EDDng."
  - "Nh\xE2n ch\u1EE9ng B \u2014 cung c\u1EA5p th\xF4ng tin nhi\u1EC5u c\u1EA7n ki\u1EC3m
    ch\u1EE9ng."
  caseDetails:
  - "V\u1EADt ch\u1EE9ng m\u1EABu ch\u01B0a x\xE1c \u0111\u1ECBnh ngu\u1ED3n g\u1ED1c."
  - "Nh\u1EADt k\xFD li\xEAn l\u1EA1c c\xF3 m\u1ED9t m\u1ED1c th\u1EDDi gian c\u1EA7n
    \u0111\u1ED1i chi\u1EBFu."
  clues:
  - id: brief-time
    title: "M\u1ED1c th\u1EDDi gian m\u1EABu"
    description: "T\xD3M T\u1EAET V\u1EE4 \xC1N\n[N\u1ED8I DUNG M\u1EAAU] M\u1ED9t
      s\u1EF1 vi\u1EC7c gi\u1EA3 \u0111\u1ECBnh \u0111ang \u0111\u01B0\u1EE3c \u0111i\u1EC1u
      tra. To\xE0n b\u1ED9 t\xEAn, \u0111\u1ECBa \u0111i\u1EC3m v\xE0 t\xECnh ti\u1EBFt
      s\u1EBD \u0111\u01B0\u1EE3c thay th\u1EBF b\u1EB1ng n\u1ED9i dung ch\xEDnh
      th\u1EE9c.\n\nM\u1EE4C TI\xCAU\nX\xE1c minh hai m\xE2u thu\u1EABn quan tr\u1ECDng
      trong l\u1EDDi khai c\u1EE7a b\u1ECB c\xE1o v\xE0 thu th\u1EADp manh m\u1ED1i
      cho b\u1EA3ng ch\u1EE9ng c\u1EE9."
    category: 0
  - id: brief-witness
    title: "Nh\xE2n ch\u1EE9ng m\u1EABu"
    description: "NH\xC2N CH\u1EE8NG\n\u2022 Nh\xE2n ch\u1EE9ng A \u2014 c\xF3 m\u1EB7t
      g\u1EA7n hi\u1EC7n tr\u01B0\u1EDDng.\r\n\u2022 Nh\xE2n ch\u1EE9ng B \u2014
      cung c\u1EA5p th\xF4ng tin nhi\u1EC5u c\u1EA7n ki\u1EC3m ch\u1EE9ng."
    category: 1
  - id: brief-detail
    title: "Chi ti\u1EBFt hi\u1EC7n tr\u01B0\u1EDDng"
    description: "CHI TI\u1EBET V\u1EE4 \xC1N\n\u2022 V\u1EADt ch\u1EE9ng m\u1EABu
      ch\u01B0a x\xE1c \u0111\u1ECBnh ngu\u1ED3n g\u1ED1c.\r\n\u2022 Nh\u1EADt k\xFD
      li\xEAn l\u1EA1c c\xF3 m\u1ED9t m\u1ED1c th\u1EDDi gian c\u1EA7n \u0111\u1ED1i
      chi\u1EBFu."
    category: 2
  - id: brief-objective
    title: "M\u1EE5c ti\xEAu \u0111i\u1EC1u tra"
    description: "D\xD2NG TH\u1EDCI GIAN\n\u2022 20:00 \u2014 B\u1ECB c\xE1o khai
      \u0111\xE3 r\u1EDDi khu v\u1EF1c.\r\n\u2022 20:10 \u2014 Camera m\u1EABu ghi
      nh\u1EADn chuy\u1EC3n \u0111\u1ED9ng.\r\n\u2022 20:15 \u2014 Nh\xE2n ch\u1EE9ng
      A b\xE1o c\xE1o s\u1EF1 vi\u1EC7c."
    category: 3
  - id: testimony-time
    title: "L\u1EDDi khai v\u1EC1 th\u1EDDi gian"
    description: "B\u1ECB c\xE1o n\xF3i \u0111\xE3 r\u1EDDi \u0111\u1ECBa \u0111i\u1EC3m
      tr\u01B0\u1EDBc 20:00."
    category: 4
  - id: contradiction-camera
    title: "M\xE2u thu\u1EABn camera"
    description: "Camera m\u1EABu ghi nh\u1EADn m\u1ED9t ng\u01B0\u1EDDi t\u01B0\u01A1ng
      t\u1EF1 b\u1ECB c\xE1o sau 20:10."
    category: 5
  - id: testimony-phone
    title: "L\u1EDDi khai v\u1EC1 \u0111i\u1EC7n tho\u1EA1i"
    description: "B\u1ECB c\xE1o n\xF3i \u0111i\u1EC7n tho\u1EA1i \u0111\xE3 h\u1EBFt
      pin trong bu\u1ED5i t\u1ED1i."
    category: 4
  - id: contradiction-call
    title: "M\xE2u thu\u1EABn cu\u1ED9c g\u1ECDi"
    description: "Nh\u1EADt k\xFD m\u1EABu ghi nh\u1EADn m\u1ED9t cu\u1ED9c g\u1ECDi
      l\xFAc 20:12."
    category: 5
  - id: follow-route
    title: "Tuy\u1EBFn \u0111\u01B0\u1EDDng m\u1EABu"
    description: "L\u1EDDi khai v\u1EC1 tuy\u1EBFn \u0111\u01B0\u1EDDng c\xF3 m\u1ED9t
      \u0111o\u1EA1n ch\u01B0a \u0111\u01B0\u1EE3c gi\u1EA3i th\xEDch."
    category: 4
  - id: follow-receipt
    title: "Bi\xEAn lai m\u1EABu"
    description: "Th\u1EDDi gian tr\xEAn bi\xEAn lai kh\xF4ng kh\u1EDBp ho\xE0n to\xE0n
      v\u1EDBi l\u1EDDi khai."
    category: 5
  startingClueIds:
  - brief-time
  - brief-witness
  - brief-detail
  - brief-objective
  defendantName: "B\u1ECA C\xC1O M\u1EAAU"
  questions:
  - id: main-time
    prompt: "\xD4ng/b\xE0 \u0111\xE3 \u1EDF \u0111\xE2u trong kho\u1EA3ng 20:00 \u0111\u1EBFn
      20:20?"
    keyQuestion: 1
    response:
      transcript: "[N\u1ED8I DUNG M\u1EAAU] T\xF4i \u0111\xE3 r\u1EDDi khu v\u1EF1c
        tr\u01B0\u1EDBc 20:00. Sau \u0111\xF3 t\xF4i gh\xE9 mua n\u01B0\u1EDBc, nh\u01B0ng
        kh\xF4ng nh\u1EDB t\xEAn c\u1EEDa h\xE0ng. T\xF4i ch\u1EAFc m\xECnh kh\xF4ng
        quay l\u1EA1i."
      audioClip: {fileID: 0}
      revealedClueIds:
      - testimony-time
      - contradiction-camera
    followUps:
    - id: time-route
      prompt: "\xD4ng/b\xE0 \u0111\xE3 \u0111i theo tuy\u1EBFn \u0111\u01B0\u1EDDng
        n\xE0o?"
      response:
        transcript: "[N\u1ED8I DUNG M\u1EAAU] T\xF4i \u0111i qua \u0111\u01B0\u1EDDng
          ph\xEDa \u0111\xF4ng r\u1ED3i \u0111\u1ED5i h\u01B0\u1EDBng v\xEC t\u1EAFc
          \u0111\u01B0\u1EDDng."
        audioClip: {fileID: 0}
        revealedClueIds:
        - follow-route
    - id: time-camera
      prompt: "V\xEC sao camera v\u1EABn ghi nh\u1EADn h\xECnh \u1EA3nh sau 20:10?"
      response:
        transcript: "[N\u1ED8I DUNG M\u1EAAU] Ng\u01B0\u1EDDi trong camera c\xF3
          th\u1EC3 ch\u1EC9 m\u1EB7c qu\u1EA7n \xE1o gi\u1ED1ng t\xF4i."
        audioClip: {fileID: 0}
        revealedClueIds:
        - contradiction-camera
    - id: time-receipt
      prompt: "\xD4ng/b\xE0 c\xF2n gi\u1EEF bi\xEAn lai mua h\xE0ng kh\xF4ng?"
      response:
        transcript: "[N\u1ED8I DUNG M\u1EAAU] T\xF4i c\xF3 m\u1ED9t bi\xEAn lai,
          nh\u01B0ng gi\u1EDD in tr\xEAn \u0111\xF3 c\xF3 th\u1EC3 b\u1ECB sai."
        audioClip: {fileID: 0}
        revealedClueIds:
        - follow-receipt
  - id: main-hobby
    prompt: "\xD4ng/b\xE0 th\u01B0\u1EDDng l\xE0m g\xEC v\xE0o cu\u1ED1i tu\u1EA7n?"
    keyQuestion: 0
    response:
      transcript: "[N\u1ED8I DUNG M\u1EAAU] T\xF4i th\u01B0\u1EDDng xem phim v\xE0
        d\u1ECDn nh\xE0. \u0110i\u1EC1u n\xE0y kh\xF4ng li\xEAn quan \u0111\u1EBFn
        t\u1ED1i h\xF4m \u0111\xF3."
      audioClip: {fileID: 0}
      revealedClueIds: []
    followUps: []
  - id: main-phone
    prompt: "\u0110i\u1EC7n tho\u1EA1i c\u1EE7a \xF4ng/b\xE0 ho\u1EA1t \u0111\u1ED9ng
      th\u1EBF n\xE0o trong t\u1ED1i h\xF4m \u0111\xF3?"
    keyQuestion: 1
    response:
      transcript: "[N\u1ED8I DUNG M\u1EAAU] \u0110i\u1EC7n tho\u1EA1i c\u1EE7a t\xF4i
        h\u1EBFt pin t\u1EEB s\u1EDBm n\xEAn t\xF4i kh\xF4ng g\u1ECDi cho ai. T\xF4i
        \u0111\u1EC3 m\xE1y trong t\xFAi su\u1ED1t bu\u1ED5i t\u1ED1i."
      audioClip: {fileID: 0}
      revealedClueIds:
      - testimony-phone
      - contradiction-call
    followUps:
    - id: phone-call
      prompt: "\xD4ng/b\xE0 gi\u1EA3i th\xEDch th\u1EBF n\xE0o v\u1EC1 cu\u1ED9c
        g\u1ECDi l\xFAc 20:12?"
      response:
        transcript: "[N\u1ED8I DUNG M\u1EAAU] C\xF3 th\u1EC3 cu\u1ED9c g\u1ECDi \u0111\u01B0\u1EE3c
          th\u1EF1c hi\u1EC7n tr\u01B0\u1EDBc khi m\xE1y t\u1EAFt h\u1EB3n."
        audioClip: {fileID: 0}
        revealedClueIds:
        - contradiction-call
    - id: phone-owner
      prompt: "C\xF3 ai kh\xE1c s\u1EED d\u1EE5ng \u0111i\u1EC7n tho\u1EA1i c\u1EE7a
        \xF4ng/b\xE0 kh\xF4ng?"
      response:
        transcript: "[N\u1ED8I DUNG M\u1EAAU] T\xF4i kh\xF4ng \u0111\u01B0a \u0111i\u1EC7n
          tho\u1EA1i cho ai, nh\u01B0ng c\xF3 \u0111\u1EC3 n\xF3 tr\xEAn b\xE0n v\xE0i
          ph\xFAt."
        audioClip: {fileID: 0}
        revealedClueIds:
        - testimony-phone
    - id: phone-location
      prompt: "\u0110i\u1EC7n tho\u1EA1i \u1EDF \u0111\xE2u khi \xF4ng/b\xE0 mua
        n\u01B0\u1EDBc?"
      response:
        transcript: "[N\u1ED8I DUNG M\u1EAAU] T\xF4i ngh\u0129 n\xF3 \u1EDF trong
          t\xFAi \xE1o, nh\u01B0ng t\xF4i kh\xF4ng ki\u1EC3m tra."
        audioClip: {fileID: 0}
        revealedClueIds:
        - follow-route
  - id: main-food
    prompt: "M\xF3n \u0103n y\xEAu th\xEDch c\u1EE7a \xF4ng/b\xE0 l\xE0 g\xEC?"
    keyQuestion: 0
    response:
      transcript: "[N\u1ED8I DUNG M\u1EAAU] T\xF4i th\xEDch m\xF3n \u0103n gia \u0111\xECnh.
        T\xF4i kh\xF4ng nh\u1EDB m\xECnh \u0111\xE3 \u0103n g\xEC t\u1ED1i h\xF4m
        \u0111\xF3."
      audioClip: {fileID: 0}
      revealedClueIds: []
    followUps: []
  - id: main-weather
    prompt: "\xD4ng/b\xE0 c\u1EA3m th\u1EA5y th\u1EDDi ti\u1EBFt h\xF4m \u0111\xF3
      th\u1EBF n\xE0o?"
    keyQuestion: 0
    response:
      transcript: "[N\u1ED8I DUNG M\u1EAAU] Tr\u1EDDi h\u01A1i n\xF3ng v\xE0 c\xF3
        gi\xF3. T\xF4i kh\xF4ng ch\xFA \xFD th\xEAm chi ti\u1EBFt n\xE0o."
      audioClip: {fileID: 0}
      revealedClueIds: []
    followUps: []
  resolution:
    requiredLinks:
    - firstClueId: testimony-time
      secondClueId: contradiction-camera
    - firstClueId: testimony-phone
      secondClueId: contradiction-call
    truthConclusion: "V\xEC kh\xF4ng c\xF3 ch\u1EE9ng c\u1EE9 \u0111\xE1ng tin c\u1EADy
      x\xE1c nh\u1EADn b\u1ECB c\xE1o c\xF3 m\u1EB7t t\u1EA1i hi\u1EC7n tr\u01B0\u1EDDng
      v\xE0o th\u1EDDi \u0111i\u1EC3m x\u1EA3y ra s\u1EF1 vi\u1EC7c, n\xEAn ch\u01B0a
      \u0111\u1EE7 c\u0103n c\u1EE9 quy tr\xE1ch nhi\u1EC7m cho b\u1ECB c\xE1o."
    insufficientEvidenceMessage: "B\u1EA1n ch\u01B0a thu th\u1EADp \u0111\u1EE7 manh
      m\u1ED1i \u0111\u1EC3 x\xE1c \u0111\u1ECBnh s\u1EF1 th\u1EADt. H\xE3y th\u1EED
      l\u1EA1i v\xE0 l\u1EF1a ch\u1ECDn c\xE2u h\u1ECFi li\xEAn quan \u0111\u1EBFn
      th\u1EDDi gian v\xE0 \u0111i\u1EC7n tho\u1EA1i."
    reasoningCards:
    - id: reasoning-time
      title: "Suy lu\u1EADn v\u1EC1 m\u1ED1c th\u1EDDi gian"
      description: "L\u1EDDi khai r\u1EDDi hi\u1EC7n tr\u01B0\u1EDDng tr\u01B0\u1EDBc
        20:00 m\xE2u thu\u1EABn v\u1EDBi h\xECnh \u1EA3nh camera sau 20:10."
      requiredLinks:
      - firstClueId: testimony-time
        secondClueId: contradiction-camera
    - id: reasoning-phone
      title: "Suy lu\u1EADn v\u1EC1 cu\u1ED9c g\u1ECDi"
      description: "L\u1EDDi khai \u0111i\u1EC7n tho\u1EA1i h\u1EBFt pin m\xE2u thu\u1EABn
        v\u1EDBi nh\u1EADt k\xFD cu\u1ED9c g\u1ECDi l\xFAc 20:12."
      requiredLinks:
      - firstClueId: testimony-phone
        secondClueId: contradiction-call
