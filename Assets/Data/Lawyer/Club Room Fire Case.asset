%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a46e564cb23a3d74d909e3b4b7a7ff24, type: 3}
  m_Name: Club Room Fire Case
  m_EditorClassIdentifier: NCKH.Lawyer::NCKH.VR.Lawyer.LawyerCaseDefinition
  caseId: club-room-fire
  caseTitle: VỤ CHÁY PHÒNG CLB
  caseSummary: "Khoảng 16:20, một vụ cháy xảy ra tại phòng CLB của trường. Đám cháy bắt đầu gần ổ cắm điện bên bàn làm việc. Lan nói đã thấy Minh rời đi khi một thiết bị vẫn còn cắm điện; Minh khẳng định mình đã rút bộ sạc."
  investigationObjective: "Thu thập thông tin, kiểm tra lời khai và mâu thuẫn, chọn chứng cứ có giá trị, rồi xây dựng lập luận bảo vệ Minh."
  timeline:
  - "16:00 — Minh vào phòng CLB."
  - "16:03 — Minh sử dụng ổ điện gần bàn làm việc."
  - "16:05 — Minh rời phòng."
  - "16:08–16:15 — Nam ở trong phòng CLB."
  - "16:12 — Minh quay lại hành lang nhưng không vào phòng."
  - "16:20 — Hệ thống báo cháy kích hoạt."
  witnesses:
  - "Lan — khai thấy thiết bị vẫn còn cắm điện."
  - "Minh — khẳng định đã rút bộ sạc trước khi rời đi."
  - "Nam — vào phòng sau Minh và khai chỉ vào lấy balo."
  - "Hai học sinh hành lang — cung cấp thông tin về khói và mùi khét."
  caseDetails:
  - "Điểm khởi phát nằm gần ổ cắm điện bên bàn làm việc."
  - "Chưa xác định thiết bị cụ thể gây ra sự cố."
  - "Nội quy yêu cầu rút thiết bị điện cá nhân trước khi rời phòng."
  clues:
  - {id: clue-01, title: Camera hành lang, description: "16:00: Minh vào phòng CLB. 16:05: Minh rời khỏi phòng. Camera không ghi lại được bên trong phòng.", category: 0}
  - {id: clue-02, title: Camera trong phòng, description: "16:03: Minh sử dụng ổ điện gần bàn làm việc, cũng là khu vực sau đó được xác định là nơi đám cháy bắt đầu.", category: 0}
  - {id: clue-03, title: Lời khai của Lan, description: "Trước khi Minh rời đi, tôi thấy một thiết bị vẫn còn được cắm ở ổ điện.", category: 1}
  - {id: clue-04, title: Báo cáo hiện trường ban đầu, description: "Đám cháy có khả năng bắt đầu từ khu vực ổ cắm điện gần bàn làm việc, nhưng chưa xác định chính xác thiết bị nào gây ra sự cố.", category: 2}
  - {id: clue-05, title: Lời khai của Minh, description: "Em có sạc laptop ở đó, nhưng em đã rút sạc trước khi rời đi.", category: 4}
  - {id: clue-06, title: Thời điểm báo cháy, description: "16:20: Hệ thống báo cháy được kích hoạt. Minh đã rời phòng 15 phút trước đó.", category: 0}
  - {id: clue-07, title: Vi phạm trước đây, description: "Hai tuần trước, Minh từng bị nhắc nhở vì tự ý sử dụng thiết bị điện. Chi tiết này không chứng minh Minh gây ra vụ cháy lần này.", category: 6}
  - {id: clue-08, title: Nội quy phòng CLB, description: "Học sinh phải rút thiết bị điện cá nhân trước khi rời khỏi phòng.", category: 2}
  - {id: clue-09, title: Camera cửa phòng, description: "16:05: Minh rời phòng với laptop và bộ sạc trên tay.", category: 0}
  - {id: clue-10, title: Camera góc khác, description: "Dây sạc Minh cầm khi rời đi giống thiết bị được Minh sử dụng lúc 16:03.", category: 5}
  - {id: clue-11, title: Nhân chứng hành lang, description: "Một học sinh đi ngang qua phòng lúc 16:07 và không phát hiện khói hoặc mùi khét.", category: 1}
  - {id: clue-12, title: Camera hành lang lúc 16:12, description: "16:12: Minh xuất hiện trở lại trước phòng CLB.", category: 0}
  - {id: clue-13, title: Camera cửa lúc 16:12, description: "Minh đứng ngoài cửa khoảng 20 giây rồi rời đi. Không ghi nhận Minh bước vào phòng.", category: 5}
  - {id: clue-14, title: Lời khai học sinh khác, description: "Một học sinh khác cũng báo ngửi thấy mùi khét khoảng 16:13.", category: 1}
  - {id: clue-15, title: Camera ghi nhận Nam, description: "16:08: Nam vào phòng. 16:15: Nam rời phòng. Có người khác ở trong phòng sau khi Minh rời đi và trước khi đám cháy được phát hiện.", category: 0}
  - {id: clue-16, title: Lời khai của Nam, description: "Nam khai chỉ vào lấy balo rồi đi ngay, nhưng camera cho thấy Nam ở trong phòng khoảng 7 phút.", category: 5}
  - {id: clue-17, title: Vị trí của Lan, description: "Lan đứng ngoài cửa, cách bàn làm việc một khoảng và bị một chiếc tủ che một phần tầm nhìn.", category: 1}
  - {id: clue-18, title: Timeline camera hoàn chỉnh, description: "16:00 Minh vào; 16:05 Minh rời; 16:08 người khác vào; 16:12 Minh quay lại hành lang nhưng không vào; 16:15 người kia rời; 16:20 báo cháy.", category: 0}
  startingClueIds: [clue-01, clue-02, clue-03, clue-04, clue-05, clue-06, clue-07, clue-08]
  defendantName: MINH
  mainQuestionLimit: 2
  questions:
  - id: main-outlet
    prompt: "Bạn đã làm gì với ổ điện trước khi rời phòng?"
    keyQuestion: 1
    response: {transcript: "Em sạc laptop vài phút. Trước khi đi, em rút sạc rồi bỏ cả laptop và bộ sạc vào balo.", audioClip: {fileID: 0}, revealedClueIds: [clue-09]}
    followUps:
    - id: outlet-charger
      prompt: "Bạn có chắc đó là bộ sạc đã cắm vào ổ điện không?"
      response: {transcript: "Có, em chỉ mang theo một bộ sạc.", audioClip: {fileID: 0}, revealedClueIds: [clue-10]}
    - id: outlet-other-device
      prompt: "Ngoài laptop, bạn có cắm thiết bị nào khác không?"
      response: {transcript: "Không.", audioClip: {fileID: 0}, revealedClueIds: []}
    - id: outlet-warning
      prompt: "Khi bạn rời đi, có dấu hiệu bất thường nào không?"
      response: {transcript: "Không. Em không thấy khói hay ngửi thấy mùi khét.", audioClip: {fileID: 0}, revealedClueIds: [clue-11]}
  - id: main-return
    prompt: "Sau khi rời phòng lúc 16:05, bạn đi đâu?"
    keyQuestion: 0
    response: {transcript: "Em xuống sân. Khoảng vài phút sau em quay lại vì nhớ ra mình để quên balo.", audioClip: {fileID: 0}, revealedClueIds: [clue-12]}
    followUps:
    - id: return-omission
      prompt: "Tại sao ban đầu bạn không nói mình quay lại?"
      response: {transcript: "Vì em không vào trong nên em nghĩ nó không liên quan.", audioClip: {fileID: 0}, revealedClueIds: []}
    - id: return-entry
      prompt: "Bạn có vào phòng lần thứ hai không?"
      response: {transcript: "Không.", audioClip: {fileID: 0}, revealedClueIds: [clue-13]}
    - id: return-warning
      prompt: "Bạn có nhận thấy điều gì bất thường khi quay lại không?"
      response: {transcript: "Em nhớ có mùi hơi khét.", audioClip: {fileID: 0}, revealedClueIds: [clue-14]}
  - id: main-other-person
    prompt: "Sau khi bạn rời đi, bạn có biết ai khác vào phòng không?"
    keyQuestion: 1
    response: {transcript: "Em không chắc. Nhưng lúc xuống cầu thang em có thấy Nam đi về phía phòng CLB.", audioClip: {fileID: 0}, revealedClueIds: [clue-15]}
    followUps:
    - id: other-person-action
      prompt: "Bạn có thấy Nam làm gì trong phòng không?"
      response: {transcript: "Không.", audioClip: {fileID: 0}, revealedClueIds: []}
    - id: other-person-purpose
      prompt: "Bạn có biết Nam vào đó để làm gì không?"
      response: {transcript: "Không.", audioClip: {fileID: 0}, revealedClueIds: [clue-16]}
    - id: other-person-blame
      prompt: "Bạn có nghĩ Nam gây ra vụ cháy không?"
      response: {transcript: "Em không biết.", audioClip: {fileID: 0}, revealedClueIds: []}
  - id: main-lan-observation
    prompt: "Bạn nghĩ tại sao Lan nói bạn để thiết bị cắm lại?"
    keyQuestion: 0
    response: {transcript: "Em không biết. Có thể Lan nhìn nhầm vì từ chỗ Lan đứng không nhìn rõ ổ điện.", audioClip: {fileID: 0}, revealedClueIds: [clue-17]}
    followUps:
    - id: lan-direct-view
      prompt: "Lan có nhìn trực tiếp vào ổ điện không?"
      response: {transcript: "Em không biết.", audioClip: {fileID: 0}, revealedClueIds: []}
    - id: lan-laptop-view
      prompt: "Lan có thể nhìn thấy laptop của bạn không?"
      response: {transcript: "Có thể thấy bàn, nhưng em không nghĩ nhìn rõ ổ cắm.", audioClip: {fileID: 0}, revealedClueIds: []}
    - id: lan-conflict
      prompt: "Bạn và Lan có mâu thuẫn gì không?"
      response: {transcript: "Không.", audioClip: {fileID: 0}, revealedClueIds: []}
  - id: main-full-timeline
    prompt: "Hãy kể lại toàn bộ những gì bạn làm từ 16:00 đến 16:20."
    keyQuestion: 0
    response: {transcript: "16:00 em vào phòng. Em sạc laptop một lúc. Khoảng 16:05 em rút sạc rồi rời đi. Sau đó em xuống sân. Khoảng 16:12 em quay lại lấy balo nhưng không vào phòng.", audioClip: {fileID: 0}, revealedClueIds: [clue-18]}
    followUps:
    - id: timeline-belongings
      prompt: "Bạn mang gì theo lúc 16:05?"
      response: {transcript: "Laptop và bộ sạc.", audioClip: {fileID: 0}, revealedClueIds: []}
    - id: timeline-bag
      prompt: "Tại sao bạn không lấy balo khi quay lại?"
      response: {transcript: "Em thấy cửa đóng nên nghĩ sẽ quay lại sau.", audioClip: {fileID: 0}, revealedClueIds: []}
    - id: timeline-omission
      prompt: "Tại sao lời khai đầu tiên không nhắc việc quay lại?"
      response: {transcript: "Em quên nói vì em không vào phòng.", audioClip: {fileID: 0}, revealedClueIds: []}
  resolution:
    requiredLinks:
    - {firstClueId: clue-01, secondClueId: clue-09}
    - {firstClueId: clue-11, secondClueId: clue-15}
    - {firstClueId: clue-04, secondClueId: clue-10}
    truthConclusion: "Camera cho thấy Minh đã rời phòng 15 phút trước khi báo cháy kích hoạt; lời khai của Lan và Minh mâu thuẫn trực tiếp; báo cáo hiện trường chưa xác định bộ sạc của Minh là nguyên nhân. Vì vậy, chứng cứ hiện tại chưa đủ để kết luận Minh gây ra vụ cháy."
    insufficientEvidenceMessage: "Bạn chưa có đủ chứng cứ để xây dựng lập luận bảo vệ Minh. Hãy kiểm tra các mốc thời gian, độ tin cậy của lời khai và nguyên nhân chưa được xác định."
    reasoningCards:
    - id: reasoning-time-gap
      title: Mang bộ sạc rời phòng
      description: "Camera ghi nhận Minh rời phòng lúc 16:05 cùng laptop và bộ sạc."
      requiredLinks: [{firstClueId: clue-01, secondClueId: clue-09}]
    - id: reasoning-conflicting-testimony
      title: Người khác tiếp cận hiện trường
      description: "Lúc 16:07 chưa có dấu hiệu cháy rõ ràng; sau đó Nam vào phòng từ 16:08 đến 16:15."
      requiredLinks: [{firstClueId: clue-11, secondClueId: clue-15}]
    - id: reasoning-unknown-cause
      title: Chưa xác định nguyên nhân
      description: "Báo cáo chưa xác định thiết bị gây cháy, trong khi camera cho thấy Minh mang bộ sạc rời đi."
      requiredLinks: [{firstClueId: clue-04, secondClueId: clue-10}]
