  m_Script: {fileID: 11500000, guid: 0e9fcfdc0faab7e499d085f5d5ebf657, type: 3}
  m_Name: 15 - Viem ket mac
  m_EditorClassIdentifier: NCKH.Doctor::NCKH.VR.Doctor.DoctorCaseDefinition
  patientName: "Tr\u1ECBnh H\u1EA3i Y\u1EBFn"
  selectionWeight: 1
  initialDialogue:
    transcript: "T\u1EEB s\xE1ng nay m\u1EAFt tr\xE1i t\xF4i \u0111\u1ECF, c\u1ED9m
      nh\u01B0 c\xF3 c\xE1t v\xE0 ch\u1EA3y nhi\u1EC1u n\u01B0\u1EDBc m\u1EAFt."
    audioClip: {fileID: 0}
    selectableCards:
    - id: conj-time
      text: "Kh\u1EDFi ph\xE1t s\xE1ng nay"
      correctCategory: 0
      essential: 1
    - id: conj-red
      text: "M\u1EAFt tr\xE1i \u0111\u1ECF v\xE0 c\u1ED9m"
      correctCategory: 2
      essential: 1
    - id: conj-tear
      text: "Ch\u1EA3y nhi\u1EC1u n\u01B0\u1EDBc m\u1EAFt"
      correctCategory: 2
      essential: 1
  phases:
  - id: conj-q1
    question: "M\u1EAFt c\xF3 gh\xE8n, ng\u1EE9a ho\u1EB7c \u0111au nhi\u1EC1u kh\xF4ng?"
    response:
      transcript: "M\u1EAFt h\u01A1i ng\u1EE9a, s\xE1ng ng\u1EE7 d\u1EADy c\xF3 gh\xE8n
        v\xE0ng l\xE0m d\xEDnh mi, nh\u01B0ng kh\xF4ng \u0111au s\xE2u trong m\u1EAFt."
      audioClip: {fileID: 0}
      selectableCards:
      - id: conj-discharge
        text: "Ng\u1EE9a nh\u1EB9 v\xE0 c\xF3 gh\xE8n v\xE0ng"
        correctCategory: 2
        essential: 1
      - id: conj-no-pain
        text: "Kh\xF4ng \u0111au s\xE2u trong m\u1EAFt"
        correctCategory: 2
        essential: 1
  - id: conj-q2
    question: "Ch\u1ECB c\xF3 ti\u1EBFp x\xFAc v\u1EDBi ng\u01B0\u1EDDi \u0111au
      m\u1EAFt ho\u1EB7c d\xF9ng chung \u0111\u1ED3 c\xE1 nh\xE2n kh\xF4ng?"
    response:
      transcript: "Con t\xF4i c\u0169ng \u0111\u1ECF m\u1EAFt t\u1EEB hai ng\xE0y
        tr\u01B0\u1EDBc v\xE0 ch\xFAng t\xF4i d\xF9ng chung kh\u0103n m\u1EB7t."
      audioClip: {fileID: 0}
      selectableCards:
      - id: conj-contact
        text: "Ti\u1EBFp x\xFAc ng\u01B0\u1EDDi \u0111\u1ECF m\u1EAFt v\xE0 d\xF9ng
          chung kh\u0103n"
        correctCategory: 1
        essential: 1
  - id: conj-q3
    question: "Ch\u1ECB c\xF3 \u0111eo k\xEDnh \xE1p tr\xF2ng ho\u1EB7c b\u1EC7nh
      m\u1EAFt tr\u01B0\u1EDBc \u0111\xE2y kh\xF4ng?"
    response:
      transcript: "T\xF4i kh\xF4ng \u0111eo k\xEDnh \xE1p tr\xF2ng v\xE0 tr\u01B0\u1EDBc
        \u0111\xE2y m\u1EAFt ho\xE0n to\xE0n b\xECnh th\u01B0\u1EDDng."
      audioClip: {fileID: 0}
      selectableCards:
      - id: conj-history
        text: "Kh\xF4ng \u0111eo k\xEDnh \xE1p tr\xF2ng, kh\xF4ng b\u1EC7nh m\u1EAFt
          tr\u01B0\u1EDBc \u0111\xE2y"
        correctCategory: 3
        essential: 1
