--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0e9fcfdc0faab7e499d085f5d5ebf657, type: 3}
  m_Name: 14 - Thuy dau
  m_EditorClassIdentifier: NCKH.Doctor::NCKH.VR.Doctor.DoctorCaseDefinition
  patientName: "L\xFD B\u1EA3o Ng\u1ECDc"
  selectionWeight: 1
  initialDialogue:
    transcript: "Hai ng\xE0y nay t\xF4i s\u1ED1t nh\u1EB9, m\u1EC7t v\xE0 n\u1ED5i
      nhi\u1EC1u n\u1ED1t \u0111\u1ECF r\u1EA5t ng\u1EE9a, sau \u0111\xF3 m\u1ED9t
      s\u1ED1 n\u1ED1t bi\u1EBFn th\xE0nh b\xF3ng n\u01B0\u1EDBc."
    audioClip: {fileID: 0}
    selectableCards:
    - id: pox-time
      text: "Ph\xE1t ban trong hai ng\xE0y"
      correctCategory: 0
      essential: 1
    - id: pox-fever
      text: "S\u1ED1t nh\u1EB9 v\xE0 m\u1EC7t"
      correctCategory: 2
      essential: 1
    - id: pox-rash
      text: "N\u1ED1t \u0111\u1ECF ng\u1EE9a ti\u1EBFn tri\u1EC3n th\xE0nh b\xF3ng
        n\u01B0\u1EDBc"
      correctCategory: 2
      essential: 1
  phases:
  - id: pox-q1
    question: "C\xE1c n\u1ED1t b\u1EAFt \u0111\u1EA7u \u1EDF \u0111\xE2u v\xE0 c\xF3
      xu\u1EA5t hi\u1EC7n th\xE0nh nhi\u1EC1u \u0111\u1EE3t kh\xF4ng?"
    response:
      transcript: "N\u1ED1t b\u1EAFt \u0111\u1EA7u \u1EDF th\xE2n m\xECnh r\u1ED3i
        lan l\xEAn m\u1EB7t; hi\u1EC7n c\xF3 c\u1EA3 n\u1ED1t \u0111\u1ECF m\u1EDBi
        l\u1EABn b\xF3ng n\u01B0\u1EDBc v\xE0 n\u1ED1t \u0111\xF3ng v\u1EA3y."
      audioClip: {fileID: 0}
      selectableCards:
      - id: pox-pattern
        text: "Ban t\u1EEB th\xE2n m\xECnh lan ra, nhi\u1EC1u giai \u0111o\u1EA1n
          c\xF9ng l\xFAc"
        correctCategory: 2
        essential: 1
  - id: pox-q2
    question: "G\u1EA7n \u0111\xE2y em c\xF3 ti\u1EBFp x\xFAc v\u1EDBi ai b\u1ECB
      ph\xE1t ban kh\xF4ng?"
    response:
      transcript: "Kho\u1EA3ng hai tu\u1EA7n tr\u01B0\u1EDBc em ch\u01A1i c\xF9ng
        em h\u1ECD, sau \u0111\xF3 b\u1EA1n \u1EA5y \u0111\u01B0\u1EE3c ch\u1EA9n
        \u0111o\xE1n th\u1EE7y \u0111\u1EADu."
      audioClip: {fileID: 0}
      selectableCards:
      - id: pox-contact
        text: "Ti\u1EBFp x\xFAc ca th\u1EE7y \u0111\u1EADu kho\u1EA3ng hai tu\u1EA7n
          tr\u01B0\u1EDBc"
        correctCategory: 1
        essential: 1
  - id: pox-q3
    question: "Em \u0111\xE3 ti\xEAm v\u1EAFc-xin ho\u1EB7c t\u1EEBng b\u1ECB th\u1EE7y
      \u0111\u1EADu ch\u01B0a?"
    response:
      transcript: "Em ch\u01B0a t\u1EEBng m\u1EAFc v\xE0 gia \u0111\xECnh kh\xF4ng
        nh\u1EDB em \u0111\xE3 ti\xEAm v\u1EAFc-xin th\u1EE7y \u0111\u1EADu."
      audioClip: {fileID: 0}
      selectableCards:
      - id: pox-history
        text: "Ch\u01B0a t\u1EEBng m\u1EAFc, kh\xF4ng r\xF5 ti\u1EC1n s\u1EED ti\xEAm
          v\u1EAFc-xin"
        correctCategory: 3
        essential: 1
