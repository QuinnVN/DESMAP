--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0e9fcfdc0faab7e499d085f5d5ebf657, type: 3}
  m_Name: 03 - Sot xuat huyet Dengue
  m_EditorClassIdentifier: NCKH.Doctor::NCKH.VR.Doctor.DoctorCaseDefinition
  patientName: "L\xEA Thu H\xE0"
  selectionWeight: 1
  initialDialogue:
    transcript: "T\xF4i s\u1ED1t cao li\xEAn t\u1EE5c t\u1EEB ba ng\xE0y nay, \u0111au
      \u0111\u1EA7u d\u1EEF d\u1ED9i, \u0111au sau hai m\u1EAFt v\xE0 nh\u1EE9c m\u1ECFi
      kh\u1EAFp ng\u01B0\u1EDDi."
    audioClip: {fileID: 0}
    selectableCards:
    - id: dengue-time
      text: "S\u1ED1t cao li\xEAn t\u1EE5c ba ng\xE0y"
      correctCategory: 0
      essential: 1
    - id: dengue-head
      text: "\u0110au \u0111\u1EA7u d\u1EEF d\u1ED9i"
      correctCategory: 2
      essential: 1
    - id: dengue-eyes
      text: "\u0110au sau hai m\u1EAFt"
      correctCategory: 2
      essential: 1
    - id: dengue-ache
      text: "\u0110au nh\u1EE9c c\u01A1 th\u1EC3"
      correctCategory: 2
      essential: 1
  phases:
  - id: dengue-q1
    question: "Ch\u1ECB c\xF3 bu\u1ED3n n\xF4n, ph\xE1t ban ho\u1EB7c ch\u1EA3y m\xE1u
      b\u1EA5t th\u01B0\u1EDDng kh\xF4ng?"
    response:
      transcript: "T\xF4i bu\u1ED3n n\xF4n, tr\xEAn tay m\u1EDBi n\u1ED5i v\xE0i
        ch\u1EA5m \u0111\u1ECF nh\u01B0ng ch\u01B0a ch\u1EA3y m\xE1u m\u0169i hay
        ch\xE2n r\u0103ng."
      audioClip: {fileID: 0}
      selectableCards:
      - id: dengue-nausea
        text: "Bu\u1ED3n n\xF4n"
        correctCategory: 2
        essential: 1
      - id: dengue-rash
        text: "Xu\u1EA5t hi\u1EC7n ch\u1EA5m \u0111\u1ECF tr\xEAn tay"
        correctCategory: 2
        essential: 1
      - id: dengue-no-bleed
        text: "Ch\u01B0a c\xF3 ch\u1EA3y m\xE1u b\u1EA5t th\u01B0\u1EDDng"
        correctCategory: 2
        essential: 1
  - id: dengue-q2
    question: "G\u1EA7n \u0111\xE2y ch\u1ECB c\xF3 b\u1ECB mu\u1ED7i \u0111\u1ED1t
      ho\u1EB7c \u0111\u1EBFn n\u01A1i \u0111ang c\xF3 d\u1ECBch kh\xF4ng?"
    response:
      transcript: "Khu ph\u1ED1 t\xF4i c\xF3 nhi\u1EC1u mu\u1ED7i sau m\u01B0a v\xE0
        tu\u1EA7n tr\u01B0\u1EDBc \u0111\xE3 c\xF3 ng\u01B0\u1EDDi m\u1EAFc s\u1ED1t
        xu\u1EA5t huy\u1EBFt."
      audioClip: {fileID: 0}
      selectableCards:
      - id: dengue-exposure
        text: "Nhi\u1EC1u mu\u1ED7i v\xE0 c\xF3 ca s\u1ED1t xu\u1EA5t huy\u1EBFt
          trong khu ph\u1ED1"
        correctCategory: 1
        essential: 1
  - id: dengue-q3
    question: "Ch\u1ECB c\xF3 \u0111au b\u1EE5ng nhi\u1EC1u, n\xF4n li\xEAn t\u1EE5c
      hay th\u1EA5y l\u1EA3 \u0111i kh\xF4ng?"
    response:
      transcript: "T\xF4i ch\u1EC9 h\u01A1i kh\xF3 ch\u1ECBu \u1EDF b\u1EE5ng, ch\u01B0a
        n\xF4n v\xE0 v\u1EABn u\u1ED1ng \u0111\u01B0\u1EE3c n\u01B0\u1EDBc."
      audioClip: {fileID: 0}
      selectableCards:
      - id: dengue-warning
        text: "Ch\u01B0a c\xF3 d\u1EA5u hi\u1EC7u c\u1EA3nh b\xE1o r\xF5"
        correctCategory: 2
        essential: 1
  - id: dengue-q4
    question: "Ch\u1ECB t\u1EEBng m\u1EAFc s\u1ED1t xu\u1EA5t huy\u1EBFt ho\u1EB7c
      c\xF3 b\u1EC7nh n\u1EC1n ch\u01B0a?"
    response:
      transcript: "T\xF4i t\u1EEBng m\u1EAFc s\u1ED1t xu\u1EA5t huy\u1EBFt c\xE1ch
        \u0111\xE2y s\xE1u n\u0103m v\xE0 kh\xF4ng c\xF3 b\u1EC7nh n\u1EC1n kh\xE1c."
      audioClip: {fileID: 0}
      selectableCards:
      - id: dengue-history
        text: "T\u1EEBng m\u1EAFc s\u1ED1t xu\u1EA5t huy\u1EBFt s\xE1u n\u0103m tr\u01B0\u1EDBc"
        correctCategory: 3
        essential: 1
