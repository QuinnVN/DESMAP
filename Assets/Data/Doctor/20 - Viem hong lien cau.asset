  m_Script: {fileID: 11500000, guid: 0e9fcfdc0faab7e499d085f5d5ebf657, type: 3}
  m_Name: 20 - Viem hong lien cau
  m_EditorClassIdentifier: NCKH.Doctor::NCKH.VR.Doctor.DoctorCaseDefinition
  patientName: "\u0110inh Th\xF9y Trang"
  selectionWeight: 1
  initialDialogue:
    transcript: "T\xF4i \u0111\u1ED9t ng\u1ED9t s\u1ED1t v\xE0 \u0111au h\u1ECDng
      d\u1EEF d\u1ED9i t\u1EEB h\xF4m qua, nu\u1ED1t r\u1EA5t \u0111au nh\u01B0ng
      h\u1EA7u nh\u01B0 kh\xF4ng ho."
    audioClip: {fileID: 0}
    selectableCards:
    - id: strep-time
      text: "Kh\u1EDFi ph\xE1t \u0111\u1ED9t ng\u1ED9t t\u1EEB h\xF4m qua"
      correctCategory: 0
      essential: 1
    - id: strep-fever
      text: "S\u1ED1t v\xE0 \u0111au h\u1ECDng d\u1EEF d\u1ED9i"
      correctCategory: 2
      essential: 1
    - id: strep-swallow
      text: "Nu\u1ED1t \u0111au"
      correctCategory: 2
      essential: 1
    - id: strep-no-cough
      text: "H\u1EA7u nh\u01B0 kh\xF4ng ho"
      correctCategory: 2
      essential: 1
  phases:
  - id: strep-q1
    question: "Ch\u1ECB c\xF3 n\u1ED5i h\u1EA1ch, ch\u1EA5m \u0111\u1ECF ho\u1EB7c
      m\u1EE7 \u1EDF h\u1ECDng kh\xF4ng?"
    response:
      transcript: "T\xF4i s\u1EDD th\u1EA5y h\u1EA1ch \u0111au \u1EDF tr\u01B0\u1EDBc
        c\u1ED5; amidan c\xF3 m\u1EA3ng tr\u1EAFng v\xE0 v\xE0i ch\u1EA5m \u0111\u1ECF
        tr\xEAn v\xF2m mi\u1EC7ng."
      audioClip: {fileID: 0}
      selectableCards:
      - id: strep-nodes
        text: "H\u1EA1ch c\u1ED5 tr\u01B0\u1EDBc \u0111au"
        correctCategory: 2
        essential: 1
      - id: strep-tonsil
        text: "Amidan c\xF3 m\u1EA3ng tr\u1EAFng v\xE0 ch\u1EA5m \u0111\u1ECF v\xF2m
          mi\u1EC7ng"
        correctCategory: 2
        essential: 1
  - id: strep-q2
    question: "Ch\u1ECB c\xF3 ti\u1EBFp x\xFAc ng\u01B0\u1EDDi \u0111au h\u1ECDng
      ho\u1EB7c ti\u1EC1n s\u1EED d\u1ECB \u1EE9ng thu\u1ED1c kh\xF4ng?"
    response:
      transcript: "Em t\xF4i \u0111\u01B0\u1EE3c x\xE1c nh\u1EADn vi\xEAm h\u1ECDng
        li\xEAn c\u1EA7u ba ng\xE0y tr\u01B0\u1EDBc; t\xF4i t\u1EEBng n\u1ED5i m\u1EC1
        \u0111ay khi d\xF9ng penicillin."
      audioClip: {fileID: 0}
      selectableCards:
      - id: strep-contact
        text: "Ti\u1EBFp x\xFAc ca vi\xEAm h\u1ECDng li\xEAn c\u1EA7u"
        correctCategory: 1
        essential: 1
      - id: strep-allergy
        text: "Ti\u1EC1n s\u1EED n\u1ED5i m\u1EC1 \u0111ay v\u1EDBi penicillin"
        correctCategory: 3
        essential: 1
