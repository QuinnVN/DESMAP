  m_Script: {fileID: 11500000, guid: 0e9fcfdc0faab7e499d085f5d5ebf657, type: 3}
  m_Name: 18 - Tang huyet ap
  m_EditorClassIdentifier: NCKH.Doctor::NCKH.VR.Doctor.DoctorCaseDefinition
  patientName: "Nguy\u1EC5n Th\u1ECB H\u1EA1nh"
  selectionWeight: 1
  initialDialogue:
    transcript: "T\xF4i kh\xF4ng th\u1EA5y b\u1EC7nh g\xEC r\xF5 r\u1EC7t, nh\u01B0ng
      ba l\u1EA7n \u0111o huy\u1EBFt \xE1p g\u1EA7n \u0111\xE2y \u1EDF nh\xE0 \u0111\u1EC1u
      kho\u1EA3ng 155 tr\xEAn 95 mmHg."
    audioClip: {fileID: 0}
    selectableCards:
    - id: htn-time
      text: "Huy\u1EBFt \xE1p cao qua ba l\u1EA7n \u0111o g\u1EA7n \u0111\xE2y"
      correctCategory: 0
      essential: 1
    - id: htn-reading
      text: "Huy\u1EBFt \xE1p t\u1EA1i nh\xE0 kho\u1EA3ng 155/95 mmHg"
      correctCategory: 2
      essential: 1
  phases:
  - id: htn-q1
    question: "Ch\u1ECB c\xF3 \u0111au \u0111\u1EA7u d\u1EEF d\u1ED9i, \u0111au ng\u1EF1c,
      kh\xF3 th\u1EDF hay nh\xECn m\u1EDD kh\xF4ng?"
    response:
      transcript: "T\xF4i ch\u1EC9 th\u1EC9nh tho\u1EA3ng \u0111au \u0111\u1EA7u
        nh\u1EB9, kh\xF4ng \u0111au ng\u1EF1c, kh\xF4ng kh\xF3 th\u1EDF v\xE0 kh\xF4ng
        nh\xECn m\u1EDD."
      audioClip: {fileID: 0}
      selectableCards:
      - id: htn-symptoms
        text: "Kh\xF4ng c\xF3 tri\u1EC7u ch\u1EE9ng c\u1EA5p t\xEDnh \u0111\xE1ng
          ch\xFA \xFD"
        correctCategory: 2
        essential: 1
  - id: htn-q2
    question: "Vi\u1EC7c \u0103n u\u1ED1ng, v\u1EADn \u0111\u1ED9ng v\xE0 h\xFAt
      thu\u1ED1c c\u1EE7a ch\u1ECB th\u1EBF n\xE0o?"
    response:
      transcript: "T\xF4i hay \u0103n m\u1EB7n, \xEDt v\u1EADn \u0111\u1ED9ng v\xE0
        kh\xF4ng h\xFAt thu\u1ED1c."
      audioClip: {fileID: 0}
      selectableCards:
      - id: htn-lifestyle
        text: "\u0102n m\u1EB7n v\xE0 \xEDt v\u1EADn \u0111\u1ED9ng"
        correctCategory: 1
        essential: 1
  - id: htn-q3
    question: "Ch\u1ECB c\xF3 b\u1EC7nh n\u1EC1n ho\u1EB7c ti\u1EC1n s\u1EED gia
      \u0111\xECnh kh\xF4ng?"
    response:
      transcript: "B\u1ED1 t\xF4i b\u1ECB t\u0103ng huy\u1EBFt \xE1p; b\u1EA3n th\xE2n
        t\xF4i th\u1EEBa c\xE2n v\xE0 c\xF3 m\u1EE1 m\xE1u cao."
      audioClip: {fileID: 0}
      selectableCards:
      - id: htn-family
        text: "B\u1ED1 b\u1ECB t\u0103ng huy\u1EBFt \xE1p"
        correctCategory: 3
        essential: 1
      - id: htn-history
        text: "Th\u1EEBa c\xE2n v\xE0 m\u1EE1 m\xE1u cao"
        correctCategory: 3
        essential: 1
