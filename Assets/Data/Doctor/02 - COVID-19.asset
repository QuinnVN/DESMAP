--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0e9fcfdc0faab7e499d085f5d5ebf657, type: 3}
  m_Name: 02 - COVID-19
  m_EditorClassIdentifier: NCKH.Doctor::NCKH.VR.Doctor.DoctorCaseDefinition
  patientName: "Tr\u1EA7n Ho\xE0ng Nam"
  selectionWeight: 1
  initialDialogue:
    transcript: "T\xF4i ho, \u0111au h\u1ECDng v\xE0 m\u1EC7t t\u1EEB hai ng\xE0y
      tr\u01B0\u1EDBc. S\xE1ng nay t\xF4i nh\u1EADn ra \u0111\u1ED3 \u0103n g\u1EA7n
      nh\u01B0 kh\xF4ng c\xF2n m\xF9i v\u1ECB."
    audioClip: {fileID: 0}
    selectableCards:
    - id: covid-time
      text: "Kh\u1EDFi ph\xE1t hai ng\xE0y tr\u01B0\u1EDBc"
      correctCategory: 0
      essential: 1
    - id: covid-cough
      text: "Ho v\xE0 \u0111au h\u1ECDng"
      correctCategory: 2
      essential: 1
    - id: covid-fatigue
      text: "M\u1EC7t m\u1ECFi"
      correctCategory: 2
      essential: 1
    - id: covid-smell
      text: "Gi\u1EA3m kh\u1EE9u gi\xE1c v\xE0 v\u1ECB gi\xE1c"
      correctCategory: 2
      essential: 1
  phases:
  - id: covid-q1
    question: "Anh c\xF3 s\u1ED1t ho\u1EB7c kh\xF3 th\u1EDF kh\xF4ng?"
    response:
      transcript: "T\xF4i s\u1ED1t nh\u1EB9 38 \u0111\u1ED9 v\xE0 h\u01A1i h\u1EE5t
        h\u01A1i khi leo c\u1EA7u thang, nh\u01B0ng l\xFAc ng\u1ED3i ngh\u1EC9 v\u1EABn
        th\u1EDF \u0111\u01B0\u1EE3c."
      audioClip: {fileID: 0}
      selectableCards:
      - id: covid-fever
        text: "S\u1ED1t nh\u1EB9 38 \u0111\u1ED9"
        correctCategory: 2
        essential: 1
      - id: covid-breath
        text: "H\u1EE5t h\u01A1i khi g\u1EAFng s\u1EE9c"
        correctCategory: 2
        essential: 1
  - id: covid-q2
    question: "G\u1EA7n \u0111\xE2y anh c\xF3 ti\u1EBFp x\xFAc v\u1EDBi ca b\u1EC7nh
      kh\xF4ng?"
    response:
      transcript: "B\u1ED1n ng\xE0y tr\u01B0\u1EDBc t\xF4i d\u1EF1 cu\u1ED9c h\u1ECDp;
        sau \u0111\xF3 m\u1ED9t ng\u01B0\u1EDDi b\xE1o x\xE9t nghi\u1EC7m COVID-19
        d\u01B0\u01A1ng t\xEDnh."
      audioClip: {fileID: 0}
      selectableCards:
      - id: covid-contact
        text: "Ti\u1EBFp x\xFAc ca COVID-19 b\u1ED1n ng\xE0y tr\u01B0\u1EDBc"
        correctCategory: 1
        essential: 1
  - id: covid-q3
    question: "Anh \u0111\xE3 l\xE0m x\xE9t nghi\u1EC7m ch\u01B0a?"
    response:
      transcript: "T\xF4i th\u1EED test nhanh s\xE1ng nay v\xE0 th\u1EA5y hai v\u1EA1ch."
      audioClip: {fileID: 0}
      selectableCards:
      - id: covid-test
        text: "Test nhanh d\u01B0\u01A1ng t\xEDnh"
        correctCategory: 3
        essential: 1
  - id: covid-q4
    question: "Anh c\xF3 b\u1EC7nh n\u1EC1n ho\u1EB7c ti\u1EC1n s\u1EED ti\xEAm ch\u1EE7ng
      th\u1EBF n\xE0o?"
    response:
      transcript: "T\xF4i b\u1ECB t\u0103ng huy\u1EBFt \xE1p v\xE0 m\u0169i v\u1EAFc-xin
        COVID-19 g\u1EA7n nh\u1EA5t \u0111\xE3 h\u01A1n m\u1ED9t n\u0103m."
      audioClip: {fileID: 0}
      selectableCards:
      - id: covid-hypertension
        text: "Ti\u1EC1n s\u1EED t\u0103ng huy\u1EBFt \xE1p"
        correctCategory: 3
        essential: 1
      - id: covid-vaccine
        text: "M\u0169i v\u1EAFc-xin g\u1EA7n nh\u1EA5t h\u01A1n m\u1ED9t n\u0103m"
        correctCategory: 3
        essential: 1
