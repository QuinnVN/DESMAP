      text: Bought a new umbrella
      correctCategory: 0
      essential: 0
  phases:
  - id: b-when
    question: When did the pain start?
    response:
      transcript: The pain began shortly after breakfast this morning.
      audioClip: {fileID: 0}
      selectableCards:
      - id: b-breakfast
        text: Ate breakfast before the pain
        correctCategory: 0
        essential: 0
  - id: b-travel-q
    question: Have you travelled recently?
    response:
      transcript: I returned from a coastal trip two days ago and spent most of it
        reading.
      audioClip: {fileID: 0}
      selectableCards:
      - id: b-travel
        text: Returned from a coastal trip two days ago
        correctCategory: 1
        essential: 1
      - id: b-reading
        text: Read during the trip
        correctCategory: 0
        essential: 0
  - id: b-symptoms-q
    question: Are there any other symptoms?
    response:
      transcript: No other symptoms, although I am tired because I stayed up late.
      audioClip: {fileID: 0}
      selectableCards:
      - id: b-late
