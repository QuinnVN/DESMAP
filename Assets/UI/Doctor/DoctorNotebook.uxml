<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/Doctor/DoctorNotebook.uss" />
    <ui:VisualElement name="app-root" class="app-root" picking-mode="Ignore">
        <ui:VisualElement name="timer-badge" class="timer-badge" picking-mode="Ignore">
            <ui:Label text="5:00" name="timer-label" class="timer-label" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="preparation-overlay" class="screen-overlay preparation-overlay">
            <ui:Label text="GET READY" class="overlay-kicker" picking-mode="Ignore" />
            <ui:Label text="10" name="preparation-label" class="preparation-label" picking-mode="Ignore" />
            <ui:Label text="Listen carefully. Keep only the essential medical facts." class="overlay-subtitle" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:VisualElement name="notebook-overlay" class="screen-overlay notebook-overlay">
            <ui:VisualElement class="notebook-shell">
                <ui:VisualElement class="notebook-header">
                    <ui:VisualElement>
                        <ui:Label text="PATIENT NOTES" class="notebook-kicker" />
                        <ui:Label text="Placeholder Patient" name="patient-name-label" class="patient-name" />
                    </ui:VisualElement>
                    <ui:VisualElement class="header-actions">
                        <ui:Label text="Questions: 0/2" name="question-count-label" class="question-count" />
                        <ui:Button text="Close" name="close-button" class="button button-secondary" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Label text="Drag a fact into a category, or select a fact and then select a category." name="notebook-hint-label" class="notebook-hint" />

                <ui:VisualElement class="notebook-pages">
                    <ui:VisualElement class="page page-left">
                        <ui:Label text="UNFILED FACTS" class="section-title" />
                        <ui:VisualElement name="unfiled-drop" class="drop-zone unfiled-drop">
                            <ui:ScrollView class="card-scroll" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden">
                                <ui:VisualElement name="unfiled-content" class="card-list" />
                            </ui:ScrollView>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="binding" picking-mode="Ignore" />

                    <ui:VisualElement class="page page-right">
                        <ui:VisualElement class="category-row first-category-row">
                            <ui:VisualElement name="time-drop" class="drop-zone category-zone">
                                <ui:Label text="TIME" class="category-title" />
                                <ui:ScrollView class="card-scroll" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden">
                                    <ui:VisualElement name="time-content" class="card-list compact-list" />
                                </ui:ScrollView>
                            </ui:VisualElement>
                            <ui:VisualElement name="travel-drop" class="drop-zone category-zone">
                                <ui:Label text="TRAVEL HISTORY" class="category-title" />
                                <ui:ScrollView class="card-scroll" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden">
                                    <ui:VisualElement name="travel-content" class="card-list compact-list" />
                                </ui:ScrollView>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="category-row">
                            <ui:VisualElement name="symptoms-drop" class="drop-zone category-zone">
                                <ui:Label text="SYMPTOMS" class="category-title" />
                                <ui:ScrollView class="card-scroll" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden">
                                    <ui:VisualElement name="symptoms-content" class="card-list compact-list" />
                                </ui:ScrollView>
                            </ui:VisualElement>
                            <ui:VisualElement name="history-drop" class="drop-zone category-zone">
                                <ui:Label text="MEDICAL HISTORY" class="category-title" />
                                <ui:ScrollView class="card-scroll" vertical-scroller-visibility="Auto" horizontal-scroller-visibility="Hidden">
                                    <ui:VisualElement name="history-content" class="card-list compact-list" />
                                </ui:ScrollView>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="notebook-footer">
                    <ui:Button text="Ask Patient" name="ask-button" class="button button-secondary action-button" />
                    <ui:Label text="Leave unrelated details in Unfiled Facts." class="footer-tip" />
                    <ui:Button text="Diagnose" name="diagnose-button" class="button button-primary action-button" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="question-modal" class="screen-overlay modal-overlay">
            <ui:VisualElement class="modal-card">
                <ui:Label text="ASK ABOUT..." class="modal-title" />
                <ui:Label text="Choose carefully. You can ask at most two categories." class="modal-subtitle" />
                <ui:VisualElement class="question-grid">
                    <ui:Button text="Time" name="question-time-button" class="button question-button" />
                    <ui:Button text="Travel History" name="question-travel-button" class="button question-button" />
                    <ui:Button text="Symptoms" name="question-symptoms-button" class="button question-button" />
                    <ui:Button text="Medical History" name="question-history-button" class="button question-button" />
                </ui:VisualElement>
                <ui:Button text="Cancel" name="question-cancel-button" class="button button-secondary cancel-button" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="conclusion-overlay" class="screen-overlay conclusion-overlay">
            <ui:VisualElement class="conclusion-card">
                <ui:Label text="CONCLUSION" class="overlay-kicker dark-kicker" />
                <ui:Label text="Placeholder conclusion" name="conclusion-title" class="conclusion-title" />
                <ui:Label text="Placeholder treatment" name="conclusion-body" class="conclusion-body" />
                <ui:Label text="Preparing the next patient..." class="conclusion-wait" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="result-overlay" class="screen-overlay result-overlay">
            <ui:Label text="ROUND COMPLETE" class="overlay-kicker" />
            <ui:Label text="TOTAL SCORE&#10;0" name="result-score" class="result-score" />
            <ui:Label text="Every correctly filed essential fact earned one point." class="overlay-subtitle" />
        </ui:VisualElement>

        <ui:VisualElement name="drag-layer" class="drag-layer" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
